<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AiTextAdventure.ViewModels"
             x:Class="AiTextAdventure.Views.JournalPage"
             x:DataType="vm:JournalViewModel"
             Title="Journal">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <Label Grid.Row="0" Text="Adventure Journal" FontSize="24" FontAttributes="Bold" Margin="0,0,0,16" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Entries}">
            <CollectionView.EmptyView>
                <Label Text="No journal entries yet. Start your adventure!" HorizontalTextAlignment="Center"
                       TextColor="Gray" Margin="0,32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:Object">
                    <StackLayout Padding="0,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="{Binding Type, StringFormat='[{0}]'}"
                                   TextColor="Gold" FontSize="12" Margin="0,0,8,0" VerticalOptions="Start" />
                            <StackLayout Grid.Column="1">
                                <Label Text="{Binding EntryText}" FontSize="14" LineBreakMode="WordWrap" />
                                <Label Text="{Binding Timestamp, StringFormat='{0:MMM d, yyyy HH:mm}'}"
                                       TextColor="Gray" FontSize="11" HorizontalTextAlignment="End" />
                            </StackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="DarkGray" Margin="0,8" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
