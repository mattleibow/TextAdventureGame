<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AiTextAdventure.ViewModels"
             x:Class="AiTextAdventure.Views.JournalPage"
             x:DataType="vm:JournalViewModel"
             Title=""
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Frame Grid.Row="0"
               BackgroundColor="{StaticResource PageBg}"
               BorderColor="{StaticResource BorderGold}"
               CornerRadius="0"
               Padding="20,16"
               HasShadow="False">
            <StackLayout Spacing="4">
                <Label Text="📜  EXPLORER'S CHRONICLE"
                       Style="{StaticResource SectionHeaderStyle}"
                       FontSize="16" />
                <Label Text="A record of your deeds and discoveries"
                       Style="{StaticResource MutedLabelStyle}"
                       FontAttributes="Italic" />
            </StackLayout>
        </Frame>

        <!-- Journal Entries -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Entries}"
                        Margin="16,12">
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Margin="32">
                    <Label Text="📜"
                           FontSize="48"
                           HorizontalTextAlignment="Center" />
                    <Label Text="No entries yet."
                           TextColor="{StaticResource TextMuted}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />
                    <Label Text="Begin your adventure to write your legend!"
                           TextColor="{StaticResource TextDim}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Italic" />
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:Object">
                    <StackLayout Margin="0,0,0,10">
                        <Frame Style="{StaticResource CardStyle}">
                            <StackLayout Spacing="8">
                                <!-- Entry type badge + timestamp -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="{StaticResource CardBgAlt}"
                                           BorderColor="{StaticResource BorderGold}"
                                           CornerRadius="4"
                                           Padding="8,4"
                                           HasShadow="False">
                                        <Label Text="{Binding Type}"
                                               TextColor="{StaticResource GoldText}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1" />
                                    </Frame>
                                    <BoxView Grid.Column="1"
                                             Style="{StaticResource SeparatorStyle}"
                                             Margin="0,0,0,0"
                                             VerticalOptions="Center"
                                             HeightRequest="1" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Timestamp, StringFormat='{0:MMM d}'}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           FontSize="10"
                                           VerticalOptions="Center" />
                                </Grid>

                                <!-- Entry text -->
                                <Label Text="{Binding EntryText}"
                                       Style="{StaticResource NarrativeLabelStyle}"
                                       FontSize="14" />

                                <!-- Full timestamp -->
                                <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       FontSize="10"
                                       HorizontalTextAlignment="End"
                                       FontAttributes="Italic" />
                            </StackLayout>
                        </Frame>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
