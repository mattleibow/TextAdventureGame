<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AiTextAdventure.ViewModels"
             xmlns:models="clr-namespace:AiTextAdventure.Models"
             x:Class="AiTextAdventure.Views.GamePage"
             x:DataType="vm:GameViewModel"
             Title="Adventure"
             Shell.NavBarIsVisible="False">

    <!-- Split panel: 2/3 game | 1/3 events -->
    <Grid ColumnDefinitions="2*,*">

        <!-- ═══════════════════════════════════════════════ -->
        <!-- LEFT: Game Panel                                -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Padding="16,8">

            <!-- Narrative History -->
            <ScrollView Grid.Row="0" x:Name="NarrativeScroll">
                <CollectionView ItemsSource="{Binding NarrativeHistory}"
                                x:Name="NarrativeList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NarrativeParagraph">
                            <StackLayout Padding="0,8">
                                <Label Text="{Binding Text}"
                                       FontSize="15"
                                       LineBreakMode="WordWrap"
                                       TextColor="White" />
                                <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                       FontSize="10"
                                       TextColor="Gray"
                                       HorizontalTextAlignment="End" />
                                <BoxView HeightRequest="1" Color="DarkGray" Margin="0,4" />
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <!-- Suggested Actions -->
            <FlexLayout Grid.Row="1"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Center"
                        Margin="0,8">
                <BindableLayout.ItemsSource>
                    <Binding Path="SuggestedActions" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SuggestedAction">
                        <Button Text="{Binding Label}"
                                Margin="4"
                                Padding="12,8"
                                CornerRadius="16"
                                BackgroundColor="#2C3E50"
                                TextColor="White"
                                FontSize="13"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GameViewModel}}, Path=SubmitActionCommand}"
                                CommandParameter="{Binding ActionText}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Free-text Input -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                <Entry Grid.Column="0"
                       Placeholder="What do you do?"
                       Text="{Binding PlayerInput}"
                       ReturnCommand="{Binding SubmitActionCommand}"
                       IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       BackgroundColor="#1A1A2E" />
                <Button Grid.Column="1"
                        Text="→"
                        Command="{Binding SubmitActionCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                        BackgroundColor="#E74C3C"
                        TextColor="White"
                        WidthRequest="48" />
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- RIGHT: Agent Events Panel                       -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1"
              x:Name="EventsPanel"
              RowDefinitions="Auto,*"
              BackgroundColor="#0D0D1A"
              Padding="8">

            <!-- Panel Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                <Label Grid.Column="0" Text="Agent Events" FontAttributes="Bold"
                       TextColor="Silver" FontSize="13" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Clear"
                        Command="{Binding ClearEventsCommand}"
                        FontSize="11" Padding="8,4" BackgroundColor="Transparent" TextColor="Gray" />
                <Button Grid.Column="2" Text="◀"
                        Command="{Binding ToggleVisibilityCommand}"
                        FontSize="11" Padding="8,4" BackgroundColor="Transparent" TextColor="Gray" />
            </Grid>

            <!-- Events List -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Events}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentEventViewModel">
                        <Grid ColumnDefinitions="Auto,*" Padding="4,2" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="{Binding Icon}" FontSize="12" VerticalOptions="Start" />
                            <StackLayout Grid.Column="1" Spacing="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding AgentName}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{Binding Color}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding TimeStamp}"
                                           FontSize="9"
                                           TextColor="Gray" />
                                </Grid>
                                <Label Text="{Binding Title}" FontSize="11" TextColor="Silver" />
                                <Label Text="{Binding Detail}"
                                       FontSize="10"
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       IsVisible="{Binding Detail, Converter={StaticResource NotNullConverter}}" />
                            </StackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>
</ContentPage>
