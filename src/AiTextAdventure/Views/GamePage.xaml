<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AiTextAdventure.ViewModels"
             xmlns:models="clr-namespace:AiTextAdventure.Models"
             x:Class="AiTextAdventure.Views.GamePage"
             x:DataType="vm:GameViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <!-- Split panel: 2/3 narrative | 1/3 sidebar -->
    <Grid ColumnDefinitions="2*,*">

        <!-- ═══════════════════════════════════════════════ -->
        <!-- LEFT: Game Panel                                -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*,Auto,Auto,Auto"
              BackgroundColor="{StaticResource PanelBg}">

            <!-- Row 0: Status Bar -->
            <Frame Grid.Row="0"
                   BackgroundColor="{StaticResource PageBg}"
                   BorderColor="{StaticResource BorderSubtle}"
                   CornerRadius="0"
                   Padding="16,8"
                   HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0"
                           Text="⚔  REALMS OF SHADOW"
                           TextColor="{StaticResource GoldText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="🌙"
                           FontSize="16"
                           VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Row 1: Narrative History — auto-scrolls to newest entry -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding NarrativeHistory}"
                            x:Name="NarrativeList"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            BackgroundColor="{StaticResource PanelBg}">
                <CollectionView.Header>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NarrativeParagraph">
                        <Grid Padding="12,0,12,8">
                            <Frame Style="{StaticResource NarrativeCardStyle}">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Text}"
                                           Style="{StaticResource NarrativeLabelStyle}" />
                                    <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           FontSize="10"
                                           HorizontalTextAlignment="End" />
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="4" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>

            <!-- Row 2: Processing indicator -->
            <ActivityIndicator Grid.Row="2"
                               IsRunning="{Binding IsProcessing}"
                               IsVisible="{Binding IsProcessing}"
                               Color="{StaticResource Gold}"
                               HeightRequest="24"
                               Margin="16,4" />

            <!-- Row 3: Suggested Actions -->
            <FlexLayout Grid.Row="3"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Center"
                        Margin="12,4,12,4">
                <BindableLayout.ItemsSource>
                    <Binding Path="SuggestedActions" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SuggestedAction">
                        <Button Text="{Binding Label}"
                                Style="{StaticResource SuggestionButtonStyle}"
                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:GameViewModel}}, Path=IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GameViewModel}}, Path=SubmitActionCommand}"
                                CommandParameter="{Binding ActionText}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Row 4: Command Input -->
            <Frame Grid.Row="4"
                   BackgroundColor="{StaticResource PageBg}"
                   BorderColor="{StaticResource BorderSubtle}"
                   CornerRadius="0"
                   Padding="12,10"
                   HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="›"
                           TextColor="{StaticResource Gold}"
                           FontSize="22"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="What do you do?"
                           Text="{Binding PlayerInput}"
                           ReturnCommand="{Binding SubmitActionCommand}"
                           IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextDim}"
                           BackgroundColor="Transparent"
                           FontSize="14" />
                    <Button Grid.Column="2"
                            Text="⏎"
                            Command="{Binding SubmitActionCommand}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                            Style="{StaticResource SendButtonStyle}"
                            WidthRequest="44"
                            HeightRequest="36" />
                </Grid>
            </Frame>
        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- RIGHT: Tabbed Sidebar                           -->
        <!-- x:DataType="vm:SidebarViewModel" tells the     -->
        <!-- MAUI compiled binding compiler that all         -->
        <!-- bindings in this subtree target SidebarViewModel -->
        <!-- BindingContext is set in code-behind            -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1"
              x:Name="SidebarPanel"
              x:DataType="vm:SidebarViewModel"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource EventsBg}">

            <!-- Tab bar — all bindings against SidebarViewModel -->
            <Frame Grid.Row="0"
                   BackgroundColor="{StaticResource PageBg}"
                   BorderColor="{StaticResource BorderSubtle}"
                   CornerRadius="0"
                   Padding="4,6"
                   HasShadow="False">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
                    <Button Grid.Column="0" Text="📍"
                            Style="{StaticResource GhostButtonStyle}"
                            FontSize="16" Padding="0"
                            Command="{Binding SelectStatusCommand}"
                            TextColor="{Binding IsStatusTab, Converter={StaticResource BoolToColorConverter}}" />
                    <Button Grid.Column="1" Text="🎒"
                            Style="{StaticResource GhostButtonStyle}"
                            FontSize="16" Padding="0"
                            Command="{Binding SelectPocketsCommand}"
                            TextColor="{Binding IsPocketsTab, Converter={StaticResource BoolToColorConverter}}" />
                    <Button Grid.Column="2" Text="📜"
                            Style="{StaticResource GhostButtonStyle}"
                            FontSize="16" Padding="0"
                            Command="{Binding SelectJournalCommand}"
                            TextColor="{Binding IsJournalTab, Converter={StaticResource BoolToColorConverter}}" />
                    <Button Grid.Column="3" Text="🔮"
                            Style="{StaticResource GhostButtonStyle}"
                            FontSize="16" Padding="0"
                            Command="{Binding SelectEventsCommand}"
                            TextColor="{Binding IsEventsTab, Converter={StaticResource BoolToColorConverter}}" />
                </Grid>
            </Frame>

            <!-- Tab content — each panel is a Grid child, fills the * row directly -->
            <!-- This fixes CollectionView height collapse that happens inside ScrollView+StackLayout -->
            <Grid Grid.Row="1">

                <!-- ── STATUS TAB ── -->
                <ScrollView IsVisible="{Binding IsStatusTab}">
                    <StackLayout Padding="10,8" Spacing="8">
                        <Label Text="📍 STATUS" Style="{StaticResource SectionHeaderStyle}" FontSize="11" />
                        <BoxView Style="{StaticResource GoldSeparatorStyle}" Margin="0,0" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Location" Style="{StaticResource MutedLabelStyle}" FontSize="10" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentLocation}" TextColor="{StaticResource GoldText}" FontSize="12" FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Biome" Style="{StaticResource MutedLabelStyle}" FontSize="10" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentBiome}" TextColor="{StaticResource TextPrimary}" FontSize="12" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Time" Style="{StaticResource MutedLabelStyle}" FontSize="10" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding TimeOfDay}" TextColor="{StaticResource TealText}" FontSize="12" />
                        </Grid>

                        <Label Text="{Binding RegionDescription}"
                               Style="{StaticResource MutedLabelStyle}"
                               FontSize="11"
                               LineBreakMode="WordWrap"
                               FontAttributes="Italic"
                               Margin="0,4,0,0" />

                        <Label Text="NEARBY" Style="{StaticResource SectionHeaderStyle}" FontSize="10" Margin="0,8,0,2" />
                        <CollectionView ItemsSource="{Binding NearbyEntities}" SelectionMode="None" HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="12"
                                           Padding="0,3" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </ScrollView>

                <!-- ── POCKETS TAB ── -->
                <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsPocketsTab}" Padding="10,8">
                    <Label Grid.Row="0" Text="🎒 POCKETS" Style="{StaticResource SectionHeaderStyle}" FontSize="11" />
                    <BoxView Grid.Row="1" Style="{StaticResource GoldSeparatorStyle}" Margin="0,6,0,4" />
                    <CollectionView Grid.Row="2" ItemsSource="{Binding InventoryItems}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Empty pack."
                                   Style="{StaticResource MutedLabelStyle}"
                                   FontAttributes="Italic"
                                   Margin="0,16"
                                   HorizontalTextAlignment="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:Object">
                                <Frame Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <StackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding ItemName}"
                                                   TextColor="{StaticResource GoldText}"
                                                   FontSize="13"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Description}"
                                                   Style="{StaticResource MutedLabelStyle}"
                                                   FontSize="11"
                                                   LineBreakMode="WordWrap" />
                                        </StackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding Quantity}"
                                               TextColor="{StaticResource GoldText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- ── JOURNAL TAB ── -->
                <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsJournalTab}" Padding="10,8">
                    <Label Grid.Row="0" Text="📜 JOURNAL" Style="{StaticResource SectionHeaderStyle}" FontSize="11" />
                    <BoxView Grid.Row="1" Style="{StaticResource GoldSeparatorStyle}" Margin="0,6,0,4" />
                    <CollectionView Grid.Row="2" ItemsSource="{Binding JournalEntries}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No entries yet."
                                   Style="{StaticResource MutedLabelStyle}"
                                   FontAttributes="Italic"
                                   Margin="0,16"
                                   HorizontalTextAlignment="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:Object">
                                <StackLayout Margin="0,0,0,8">
                                    <Frame Style="{StaticResource CardStyle}" Padding="10,8">
                                        <StackLayout Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Type}"
                                                       TextColor="{StaticResource GoldText}"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       CharacterSpacing="1"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="2"
                                                       Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                                       Style="{StaticResource MutedLabelStyle}"
                                                       FontSize="9"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <Label Text="{Binding EntryText}"
                                                   Style="{StaticResource NarrativeLabelStyle}"
                                                   FontSize="12"
                                                   LineBreakMode="WordWrap" />
                                        </StackLayout>
                                    </Frame>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- ── EVENTS TAB ── -->
                <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsEventsTab}" Padding="10,8">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                        <Label Grid.Column="0" Text="🔮" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="OBSERVER"
                               Style="{StaticResource SectionHeaderStyle}"
                               FontSize="10"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="Clear"
                                Style="{StaticResource GhostButtonStyle}"
                                FontSize="10"
                                Command="{Binding ClearAgentEventsCommand}" />
                    </Grid>
                    <BoxView Grid.Row="1" Style="{StaticResource GoldSeparatorStyle}" Margin="0,6,0,4" />

                    <CollectionView Grid.Row="2"
                                    ItemsSource="{Binding AgentEvents}"
                                    SelectionMode="None"
                                    ItemsUpdatingScrollMode="KeepLastItemInView">
                        <CollectionView.EmptyView>
                            <Label Text="No events yet."
                                   Style="{StaticResource MutedLabelStyle}"
                                   FontAttributes="Italic"
                                   Margin="0,16"
                                   HorizontalTextAlignment="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AgentEventViewModel">
                                <StackLayout Margin="0,0,0,4">
                                    <Frame BackgroundColor="{StaticResource CardBg}"
                                           BorderColor="{StaticResource BorderSubtle}"
                                           CornerRadius="4"
                                           Padding="8,6"
                                           HasShadow="False">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="12"
                                                   VerticalOptions="Start" />
                                            <StackLayout Grid.Column="1" Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding AgentName}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding AgentColor}" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding TimeStamp}"
                                                           FontSize="9"
                                                           TextColor="{StaticResource TextDim}" />
                                                </Grid>
                                                <Label Text="{Binding Title}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding Detail}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource TextMuted}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       IsVisible="{Binding Detail, Converter={StaticResource NotNullConverter}}" />
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
