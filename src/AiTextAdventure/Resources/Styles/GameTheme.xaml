<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:AiTextAdventure.Converters">

    <!-- Game color palette -->
    <Color x:Key="GameBackground">#0A0A1A</Color>
    <Color x:Key="GamePanelBackground">#111128</Color>
    <Color x:Key="EventsPanelBackground">#0D0D1A</Color>
    <Color x:Key="NarrativeText">#E8E8F0</Color>
    <Color x:Key="AccentGold">#D4AF37</Color>
    <Color x:Key="AccentRed">#C0392B</Color>
    <Color x:Key="AccentBlue">#2980B9</Color>
    <Color x:Key="SubtleGray">#666688</Color>

    <!-- Value Converters -->
    <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
    <conv:NotNullConverter x:Key="NotNullConverter" />
    <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />

    <!-- Base button style for action suggestions -->
    <Style x:Key="SuggestionButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#2C3E50" />
        <Setter Property="TextColor" Value="#E8E8F0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Narrative label style -->
    <Style x:Key="NarrativeLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="#E8E8F0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>

</ResourceDictionary>
